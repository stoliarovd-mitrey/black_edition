piration","wt-light"],"attributes":{"id":"inspiration-omkara","data-section-name":"Вдохновение · Omkara"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns","wt-reverse"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["wt-image-card"],"attributes":{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b7/Om_symbol.svg","alt":"Священный знак Ом, символический мотив индийского храмового искусства","data-fallback":"assets/omkara.webp"}}]},{"classes":["wt-copy"],"components":[{"tagName":"p","type":"text","classes":["wt-label"],"components":[{"type":"textnode","content":"Источник вдохновения"}]},{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Знак Ом"},{"tagName":"br","void":true},{"type":"textnode","content":"и лотос"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"В основе Omkara лежат два мотива индийского искусства: священный знак Ом и лепестки лотоса. Они определили композицию золотого медальона."}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-light"],"attributes":{"id":"omkara","data-section-name":"Omkara"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns","wt-reverse"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"assets/omkara.webp","alt":"Omkara"}}]},{"classes":["wt-copy"],"components":[{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Omkara"}]},{"tagName":"h3","type":"text","components":[{"type":"textnode","content":"Священный символ."},{"tagName":"br","void":true},{"type":"textnode","content":"Ювелирное прочтение."}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"В центре Omkara находится медальон со священным знаком Ом. Его окружают лотосы, отсылающие к индийскому храмовому искусству. Композиция выстроена вокруг символа с уважением к его духовному значению."}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Золотой рельеф задаёт границы узора, цветная ювелирная эмаль выделяет его детали. Натуральные бриллианты дополняют отделку. Сочетание материалов делает особенно важной точность небольших декоративных элементов."}]},{"type":"link","classes":["wt-button"],"attributes":{"href":"model.html?model=omkara"},"components":[{"type":"textnode","content":"Подробнее о модели"}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-inspiration","wt-dark"],"attributes":{"id":"inspiration-dali","data-section-name":"Вдохновение · Dali"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["wt-image-card"],"attributes":{"src":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Surreal.png/960px-Surreal.png","alt":"Сюрреалистический рисунок, иллюстрация идеи свободной пластики и необычной формы","data-fallback":"assets/dali.webp"}}]},{"classes":["wt-copy"],"components":[{"tagName":"p","type":"text","classes":["wt-label"],"components":[{"type":"textnode","content":"Источник вдохновения"}]},{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Текучие формы"},{"tagName":"br","void":true},{"type":"textnode","content":"сюрреализма"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Работы Сальвадора Дали вдохновили нас на текучий рельеф. Волны золотого металла словно меняют привычную форму, продолжая движение по поверхности корпуса."}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-dark"],"attributes":{"id":"dali","data-section-name":"Dali"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"assets/dali.webp","alt":"Dali"}}]},{"classes":["wt-copy"],"components":[{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Dali"}]},{"tagName":"h3","type":"text","components":[{"type":"textnode","content":"Золото вне привычных форм"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Текучие образы Сальвадора Дали стали отправной точкой дизайна. Волны металла проходят через всю панель, напоминая о свободе формы в европейском сюрреализме."}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Изогнутые золотые полосы чередуются с сиреневыми участками. В центре композиции расположена эмблема Apple с бриллиантовой инкрустацией. Чередование рельефа и цвета подчёркивает каждый изгиб."}]},{"type":"link","classes":["wt-button"],"attributes":{"href":"model.html?model=dali"},"components":[{"type":"textnode","content":"Подробнее о модели"}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-inspiration","wt-light"],"attributes":{"id":"inspiration-jingtai","data-section-name":"Вдохновение · Jingtai Blue"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns","wt-reverse"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["wt-image-card"],"attributes":{"src":"https://images.metmuseum.org/CRDImages/as/original/DP242372.jpg","alt":"Китайская ваза XVIII века, перегородчатая эмаль цзинтайлань, собрание Метрополитен-музея","data-fallback":"assets/jingtai.webp"}}]},{"classes":["wt-copy"],"components":[{"tagName":"p","type":"text","classes":["wt-label"],"components":[{"type":"textnode","content":"Источник вдохновения"}]},{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Искусство"},{"tagName":"br","void":true},{"type":"textnode","content":"цзинтайлань"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Китайская перегородчатая эмаль вдохновила палитру Jingtai Blue. Насыщенный синий цвет и цветочные мотивы подчеркнуты тонкими золотистыми контурами."}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-light"],"attributes":{"id":"jingtai","data-section-name":"Jingtai Blue"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns","wt-reverse"],"components":[{"classes":["wt-media"],"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"assets/jingtai.webp","alt":"Jingtai Blue"}}]},{"classes":["wt-copy"],"components":[{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Jingtai Blue"}]},{"tagName":"h3","type":"text","components":[{"type":"textnode","content":"Искусство цвета"},{"tagName":"br","void":true},{"type":"textnode","content":"на глубоком синем"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Jingtai Blue посвящён декоративному искусству Китая. Цветочный орнамент и насыщенный синий фон вдохновлены цзинтайлань, китайской традицией перегородчатой эмали."}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Тонкие золотистые линии очерчивают многоцветные детали. Золотое обрамление завершает композицию. Мастера Caviar передают характерную палитру и декоративную манеру цзинтайлань, используя собственное исполнение, без воспроизведения исторической технологии."}]},{"type":"link","classes":["wt-button"],"attributes":{"href":"model.html?model=jingtai"},"components":[{"type":"textnode","content":"Подробнее о модели"}]}]}]}]}]},{"tagName":"section","classes":["wt-section","wt-stone"],"attributes":{"id":"craft","data-section-name":"Мастерство"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns"],"components":[{"classes":["wt-copy"],"components":[{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Сложность"},{"tagName":"br","void":true},{"type":"textnode","content":"в каждой детали"}]}]},{"classes":["wt-copy"],"components":[{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Работа с рельефом, эмалью и инкрустацией требует разного подхода к материалу. В World Treasures отделка подчинена рисунку: его пропорциям, ритму и мельчайшим переходам."}]}]}]},{"classes":["wt-grid","c1977"],"components":[{"classes":["wt-grid-item"],"components":[{"tagName":"p","type":"text","classes":["wt-label"],"components":[{"type":"textnode","content":"РЕЛЬЕФ"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Переплетения арабесок и изгибы золотых волн создают объём. Свет становится частью рисунка."}]}]},{"classes":["wt-grid-item"],"components":[{"tagName":"p","type":"text","classes":["wt-label"],"components":[{"type":"textnode","content":"ЦВЕТ И ИНКРУСТАЦИЯ"}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"В эмалевом орнаменте важна чёткость границ цветных участков. В бриллиантовой отделке каждый камень участвует в общей композиции."}]}]}]},{"classes":["wt-gallery","wt-support-gallery","c2078"],"components":[{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"assets/qasr.webp","alt":"Крупный план платинового орнамента Qasr Al Noor"}},{"type":"image","resizable":{"ratioDefault":1},"attributes":{"src":"assets/dali.webp","alt":"Золотые волны и бриллиантовая эмблема Dali"}}]}]}]},{"tagName":"section","classes":["wt-section","wt-dark"],"attributes":{"id":"edition","data-section-name":"Лимитированная серия"},"components":[{"classes":["wt-container"],"components":[{"classes":["wt-columns"],"components":[{"classes":["wt-copy"],"components":[{"tagName":"h2","type":"text","components":[{"type":"textnode","content":"Редкость в замысле."},{"tagName":"br","void":true},{"type":"textnode","content":"Редкость в исполнении."}]},{"tagName":"p","type":"text","components":[{"type":"textnode","content":"Каждая модель выпущена ограниченным тиражом."},{"tagName":"br","void":true},{"type":"textnode","content":"Доступность экземпляров уточнит персональный консультант Caviar."}]}]},{"classes":["wt-stat-grid"],"components":[{"components":[{"type":